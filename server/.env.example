# Port (Render sets this automatically)
PORT=4000

# Postgres connection string. Leave EMPTY for local development: an embedded Postgres is used (./data/pglite).
# In production use e.g. a Neon / Render / Supabase Postgres URL.
DATABASE_URL=

# Secret shared with the website (Vercel). The website signs short-lived tokens with it; this API verifies them.
# Generate: openssl rand -base64 32     (must be IDENTICAL to API_JWT_SECRET in the client)
API_JWT_SECRET=change-me-to-a-long-random-string

# @iitjammu.ac.in accounts allowed into the admin dashboard. The FIRST one is the owner.
ADMIN_EMAILS=president@iitjammu.ac.in
