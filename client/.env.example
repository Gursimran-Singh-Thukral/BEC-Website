# Public URL of this website (Vercel gives you one; use your custom domain once attached)
SITE_URL=https://bec-iitjammu.vercel.app
AUTH_URL=https://bec-iitjammu.vercel.app

# Auth.js session secret. Generate: openssl rand -base64 32
AUTH_SECRET=change-me

# Google OAuth client (Authorised redirect URI: <SITE_URL>/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# The API server (Render). No trailing slash.
API_URL=https://bec-api.onrender.com
# Shared with the API server; must be IDENTICAL to API_JWT_SECRET there. Generate: openssl rand -base64 32
API_JWT_SECRET=change-me-to-a-long-random-string
